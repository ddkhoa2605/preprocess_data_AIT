{"text": "<meta name=\"dash-one-writer\">\n<style>\n  .au { display: grid; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n  .au-head { display: grid; gap: var(--cds-gap-sm); max-width: 72ch; }\n  .au-eyebrow { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); letter-spacing: .04em; text-transform: uppercase; }\n  .au-title { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n  .au-lede { font-size: var(--cds-font-size-body); margin: 0; line-height: 1.55; }\n  .au-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: var(--cds-gap-md); }\n  .au-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-xs); align-content: start; min-width: 0; }\n  .au-tile-label { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .au-big { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: 2.1rem; line-height: 1.1; font-variant-numeric: tabular-nums; }\n  .au-tile-note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); line-height: 1.45; }\n  .au-chip { display: inline-flex; align-items: center; gap: 6px; font-size: var(--cds-font-size-caption); font-weight: var(--cds-font-weight-medium); padding: 2px 8px; border-radius: 999px; border: 1px solid currentColor; width: fit-content; }\n  .au-chip.bad { color: var(--color-bad); }\n  .au-chip.warn { color: var(--color-warn); }\n  .au-chip.ok { color: var(--color-ok); }\n  .au-sec { display: grid; gap: var(--cds-gap-md); min-width: 0; }\n  .au-sec h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; text-wrap: balance; }\n  .au-sec > p, .au-note { margin: 0; max-width: 72ch; line-height: 1.55; color: var(--color-fg-muted); }\n  .au-sec > p b, .au-note b { color: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n  .au-grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--cds-gap-lg); }\n  .au-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-sm); min-width: 0; }\n  .au-card h3 { margin: 0; font-size: var(--cds-font-size-body); font-weight: var(--cds-font-weight-medium); }\n  .au-chart { position: relative; min-height: 160px; min-width: 0; }\n  .au-chart svg { display: block; overflow: visible; }\n  .au-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .au-legend span { display: inline-flex; align-items: center; gap: 6px; }\n  .au-sw { width: 10px; height: 10px; border-radius: 2px; display: inline-block; background: var(--cds-chart-muted); }\n  .au-sw.line { height: 2px; width: 14px; border-radius: 0; }\n  .au-axis text, .au-lab { fill: var(--cds-text-secondary); font-size: var(--cds-font-size-caption); font-family: var(--font-anthropic-sans); }\n  .au-axis path, .au-axis line { stroke: var(--cds-chart-axis); }\n  .au-gridl line { stroke: var(--cds-chart-grid); }\n  .au-gridl path { display: none; }\n  .au-val { fill: var(--color-fg); font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .au-tip { position: absolute; z-index: 5; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); box-shadow: var(--cds-shadow-popover); border-radius: var(--cds-radius); padding: 6px 10px; font-size: var(--cds-font-size-caption); color: var(--cds-text-secondary); max-width: 280px; line-height: 1.45; }\n  .au-tip .au-tip-h { color: var(--color-fg); font-weight: var(--cds-font-weight-medium); }\n  .au-fail { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); margin: 0; }\n  .au-tablewrap { overflow-x: auto; min-width: 0; }\n  .au-table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .au-table th, .au-table td { padding: 6px 10px; border-bottom: 1px solid var(--color-border-line); text-align: right; white-space: nowrap; }\n  .au-table th:first-child, .au-table td:first-child { text-align: left; }\n  .au-table th { color: var(--color-fg-muted); font-weight: var(--cds-font-weight-medium); }\n  .au-table td.zero { color: var(--color-bad); font-weight: var(--cds-font-weight-medium); }\n  .au-table td.flag { color: var(--color-warn); font-weight: var(--cds-font-weight-medium); }\n  .au-row { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm); align-items: center; }\n  .au details { border-top: 1px solid var(--color-border-line); padding-top: var(--cds-pad-md); }\n  .au details summary { cursor: pointer; font-weight: var(--cds-font-weight-medium); }\n  .au details dl { display: grid; gap: var(--cds-gap-sm); max-width: 72ch; margin: var(--cds-gap-md) 0 0; }\n  .au details dt { font-weight: var(--cds-font-weight-medium); }\n  .au details dd { margin: 0; color: var(--color-fg-muted); line-height: 1.55; }\n  [data-dash-source-state=refreshing] { opacity: .5; }\n</style>\n\n<div class=\"au\" data-read lang=\"vi\">\n  <header class=\"au-head\" id=\"tong-quan\">\n    <div class=\"au-eyebrow\">AIT Alert Data Set · 8 kịch bản · kiểm tra lại ngày 12/11/2026</div>\n    <h1 class=\"au-title\">Bộ dữ liệu sau khi kiểm tra lại nhãn</h1>\n    <p class=\"au-lede\">Trong phạm vi sản phẩm (chỉ <code>_wazuh.json</code>, đã khử trùng lặp), ba kịch bản test cho tối đa\n      <b data-draw=\"kpi-maxfixed\" data-source=\"combo_summary\" data-field=\"max_fixed\" data-row=\"0\">—</b> cụm tấn công.\n      <span class=\"au-verdict-below\">Con số này dưới mục tiêu <b data-draw=\"target\">—</b> cụm, kể cả khi đã sửa các nhãn bị bỏ sót.</span>\n      <span class=\"au-verdict-above\">Con số này đạt mục tiêu <b data-draw=\"target\">—</b> cụm sau khi sửa các nhãn bị bỏ sót.</span>\n      <span data-draw=\"verdict\"></span>\n      event_label tốt hơn time_label, nhưng vẫn bỏ sót ít nhất\n      <b data-draw=\"kpi-nmap\" data-source=\"totals\" data-field=\"nmap_unlabeled\" data-row=\"0\">—</b> alert Nmap.</p>\n  </header>\n\n  <section class=\"au-tiles\" id=\"chi-so\" aria-label=\"Chỉ số chính\">\n    <div class=\"au-tile\" id=\"tile-combo\">\n      <div class=\"au-tile-label\">Cụm tấn công, 3 kịch bản tốt nhất</div>\n      <div class=\"au-big\" data-draw=\"kpi-maxfixed2\" data-source=\"combo_summary\" data-field=\"max_fixed\" data-row=\"0\">—</div>\n      <div class=\"au-chip bad\" id=\"chip-combo\">Dưới mục tiêu</div>\n      <div class=\"au-tile-note\">Đã tính cả cụm Nmap bị bỏ sót. Chưa sửa nhãn thì chỉ có <span data-draw=\"kpi-maxraw\" data-source=\"combo_summary\" data-field=\"max_raw\" data-row=\"0\">—</span>.</div>\n    </div>\n    <div class=\"au-tile\" id=\"tile-total\">\n      <div class=\"au-tile-label\">Cụm tấn công, cả 8 kịch bản</div>\n      <div class=\"au-big\" data-draw=\"kpi-total\" data-source=\"totals\" data-field=\"attack_clusters\" data-row=\"0\">—</div>\n      <div class=\"au-tile-note\">Sau khi sửa nhãn Nmap: <span data-draw=\"kpi-totalfixed\" data-source=\"totals\" data-field=\"attack_clusters_nmap_fixed\" data-row=\"0\">—</span> cụm. Cụm gom theo rule, host và IP nguồn, tách khi lặng quá 30 phút.</div>\n    </div>\n    <div class=\"au-tile\" id=\"tile-dedup\">\n      <div class=\"au-tile-label\">Alert bị loại khi về phạm vi sản phẩm</div>\n      <div class=\"au-big\"><span data-draw=\"kpi-removed\" data-source=\"totals\" data-field=\"removed_pct\" data-row=\"0\">—</span>%</div>\n      <div class=\"au-tile-note\">Gồm AMiner và hai nguồn trùng lặp (Suricata <code>fast.log</code>, <code>mail.info</code>).</div>\n    </div>\n    <div class=\"au-tile\" id=\"tile-precision\">\n      <div class=\"au-tile-label\">Precision của time_label, russellmitchell</div>\n      <div class=\"au-big\"><span data-draw=\"kpi-prec\" data-source=\"stats\" data-field=\"precision_time_pct\" data-where=\"scenario=russellmitchell\">—</span>%</div>\n      <div class=\"au-tile-note\">So với event_label, sau khử trùng lặp. Phần còn lại là alert time_label gọi là tấn công nhưng thực ra là nhiễu nền.</div>\n    </div>\n  </section>\n\n  <section class=\"au-sec\" id=\"pham-vi\">\n    <h2>Một phần lớn số alert là AMiner hoặc bản trùng</h2>\n    <p>Mỗi alert Suricata vào Wazuh hai lần: từ <code>eve.json</code> và từ <code>fast.log</code>. Bản <code>fast.log</code> luôn có event_label \"-\", nên nếu giữ lại sẽ làm phồng số lệch nhãn. Dòng log Dovecot cũng được ghi vào cả <code>mail.info</code> lẫn <code>mail.log</code>.</p>\n    <div class=\"au-card\">\n      <div class=\"au-legend\" aria-hidden=\"true\">\n        <span><i class=\"au-sw\" data-sw=\"0\"></i>Giữ lại (phạm vi sản phẩm)</span>\n        <span><i class=\"au-sw\" data-sw=\"1\"></i>Suricata fast.log (trùng)</span>\n        <span><i class=\"au-sw\" data-sw=\"2\"></i>mail.info (trùng)</span>\n        <span><i class=\"au-sw\" data-sw=\"3\"></i>AMiner (ngoài phạm vi)</span>\n      </div>\n      <div class=\"au-chart\" id=\"chart-scope\" data-draw=\"scope\" data-source=\"stats\"></div>\n    </div>\n  </section>\n\n  <section class=\"au-sec\" id=\"khop-nhan\">\n    <h2>Hai nhãn khớp nhau ở hầu hết kịch bản, trừ harrison và santos</h2>\n    <p>Kiểu A là alert time_label gọi là tấn công nhưng event_label không gắn với sự kiện nào. Kiểu B là ngược lại. Kiểu B chỉ xuất hiện ở harrison và santos, và đều là exfiltration DNS thật (xem phần sau).</p>\n    <div class=\"au-tablewrap\">\n      <table class=\"au-table\" id=\"table-scen\" data-source=\"stats\" data-row-key=\"scenario\">\n        <thead><tr>\n          <th data-field=\"scenario\">Kịch bản</th>\n          <th data-field=\"alerts_product\">Alert (phạm vi SP)</th>\n          <th data-field=\"attack_alerts\">Alert tấn công</th>\n          <th data-field=\"agree_pct\">Khớp (%)</th>\n          <th data-field=\"type_a\">Kiểu A</th>\n          <th data-field=\"type_b\">Kiểu B</th>\n          <th data-field=\"precision_time_pct\">Precision time (%)</th>\n          <th data-field=\"recall_time_pct\">Recall time (%)</th>\n        </tr></thead>\n        <tbody data-draw=\"scen-table\"></tbody>\n      </table>\n    </div>\n    <h3 class=\"au-note\"><b>russellmitchell: bảng chéo qua từng bước lọc</b></h3>\n    <div class=\"au-tablewrap\">\n      <table class=\"au-table\" id=\"table-matrix\" data-source=\"matrix\" data-row-key=\"scope\">\n        <thead><tr>\n          <th data-field=\"scope\">Phạm vi</th>\n          <th data-field=\"both_attack\">Cả hai: tấn công</th>\n          <th data-field=\"type_a\">Kiểu A</th>\n          <th data-field=\"type_b\">Kiểu B</th>\n          <th data-field=\"both_benign\">Cả hai: bình thường</th>\n        </tr></thead>\n        <tbody data-draw=\"matrix-table\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"au-sec\" id=\"kieu-a\">\n    <h2>Kiểu A chủ yếu là nhiễu nền, nhưng có cả tấn công bị bỏ sót</h2>\n    <p>Đăng nhập Dovecot, Suricata TLS invalid và ClamAV là hoạt động bình thường xảy ra trong giờ tấn công. Các rule web 400/403 trên webserver, cloud_share và máy mail thì khác: log của chúng chứa request \"Nmap Scripting Engine\", nhưng analyze.py không nạp nhãn cho các host này.</p>\n    <div class=\"au-card\">\n      <div class=\"au-row\">\n        <label for=\"typea-scenario\" class=\"au-tile-label\">Kịch bản</label>\n        <select id=\"typea-scenario\" class=\"dash-select\" data-draw=\"typea-sel\" data-source=\"typea\" aria-label=\"Kịch bản\"></select>\n      </div>\n      <div class=\"au-legend\" aria-hidden=\"true\">\n        <span><i class=\"au-sw\" data-sw=\"0\"></i>Nhiễu nền</span>\n        <span><i class=\"au-sw\" data-sw=\"1\"></i>Tấn công bị bỏ sót (có Nmap trong log)</span>\n      </div>\n      <div class=\"au-chart\" id=\"chart-typea\" data-draw=\"typea\" data-source=\"typea\"></div>\n    </div>\n  </section>\n\n  <section class=\"au-sec\" id=\"dnsteal\">\n    <h2>Exfiltration DNS chạy từ đầu dataset và dừng ở bước service_stop</h2>\n    <p>Mỗi alert \".biz\" là một truy vấn mang một mảnh của file <code>customers_*.xlsx</code> hoặc <code>payroll_*.xlsx</code>, gửi từ internal_share. Lưu lượng đều đặn mỗi giờ và tắt đúng lúc service_stop. Khung \"dnsteal\" của time_label nằm sau đó và không chứa alert nào, nên chỗ sai là time_label, còn event_label đúng.</p>\n    <div class=\"au-legend\" aria-hidden=\"true\">\n      <span><i class=\"au-sw\" data-sw=\"0\"></i>Alert .biz mỗi giờ (bản eve.json)</span>\n      <span><i class=\"au-sw\" data-sw=\"muted\"></i>Chuỗi xâm nhập</span>\n      <span><i class=\"au-sw\" data-sw=\"warn\"></i>Khung dnsteal theo time_label</span>\n      <span><i class=\"au-sw line\" data-sw=\"crit\"></i>service_stop</span>\n    </div>\n    <div class=\"au-grid2\">\n      <div class=\"au-card\" id=\"card-biz-harrison\">\n        <h3>harrison</h3>\n        <div class=\"au-chart\" data-draw=\"biz\" data-scenario=\"harrison\" data-source=\"biz bizmarks\"></div>\n      </div>\n      <div class=\"au-card\" id=\"card-biz-santos\">\n        <h3>santos</h3>\n        <div class=\"au-chart\" data-draw=\"biz\" data-scenario=\"santos\" data-source=\"biz bizmarks\"></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"au-sec\" id=\"nmap\">\n    <h2>event_label bỏ sót request Nmap trên các host không có file nhãn</h2>\n    <p>Đếm các alert có dấu vết Nmap rõ ràng (user-agent hoặc chữ ký Suricata). Đây là cận dưới: request bị chặn không ghi user-agent thì không được đếm.</p>\n    <div class=\"au-card\">\n      <div class=\"au-legend\" aria-hidden=\"true\">\n        <span><i class=\"au-sw\" data-sw=\"0\"></i>Có nhãn tấn công</span>\n        <span><i class=\"au-sw\" data-sw=\"1\"></i>Bị gán \"-\"</span>\n      </div>\n      <div class=\"au-chart\" id=\"chart-nmap\" data-draw=\"nmap\" data-source=\"stats\"></div>\n    </div>\n  </section>\n\n  <section class=\"au-sec\" id=\"cum\">\n    <h2>Mỗi kịch bản chỉ có vài chục cụm tấn công</h2>\n    <p>Sửa nhãn Nmap chỉ thêm được vài cụm mỗi kịch bản. Bảng dưới đếm số cụm chứa từng bước tấn công: Wazuh không thấy được webshell và cracking khi không có AMiner, còn wpscan và dirb cũng chỉ có vài cụm mỗi kịch bản.</p>\n    <div class=\"au-card\">\n      <div class=\"au-legend\" aria-hidden=\"true\">\n        <span><i class=\"au-sw\" data-sw=\"0\"></i>Theo event_label gốc</span>\n        <span><i class=\"au-sw\" data-sw=\"1\"></i>Sau khi sửa nhãn Nmap</span>\n      </div>\n      <div class=\"au-chart\" id=\"chart-clusters\" data-draw=\"clusters\" data-source=\"stats\"></div>\n    </div>\n    <div class=\"au-tablewrap\">\n      <table class=\"au-table\" id=\"table-steps\" data-source=\"stats\" data-row-key=\"scenario\">\n        <thead><tr>\n          <th data-field=\"scenario\">Kịch bản</th>\n          <th data-field=\"step_service_scan\">service_scan</th>\n          <th data-field=\"step_wpscan\">wpscan</th>\n          <th data-field=\"step_dirb\">dirb</th>\n          <th data-field=\"step_webshell_cmd\">webshell_cmd</th>\n          <th data-field=\"step_crack_passwords\">crack_passwords</th>\n          <th data-field=\"step_attacker_change_user\">change_user</th>\n          <th data-field=\"step_escalated_sudo_command\">escalated_sudo</th>\n          <th data-field=\"step_dnsteal\">dnsteal</th>\n        </tr></thead>\n        <tbody data-draw=\"steps-table\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"au-sec\" id=\"to-hop\">\n    <h2>Không tổ hợp 3 kịch bản nào đạt <span data-draw=\"target\">—</span> cụm tấn công</h2>\n    <p>Mỗi chấm là một trong <span data-draw=\"kpi-ncombos\" data-source=\"combo_summary\" data-field=\"combos\" data-row=\"0\">—</span> cách chọn 3 kịch bản test. Số tổ hợp đạt mục tiêu: <b data-draw=\"kpi-reach\" data-source=\"combo_summary\" data-field=\"reaching_target\" data-row=\"0\">—</b>.</p>\n    <div class=\"au-card\">\n      <div class=\"au-legend\" aria-hidden=\"true\">\n        <span><i class=\"au-sw\" data-sw=\"0\"></i>Theo event_label gốc</span>\n        <span><i class=\"au-sw\" data-sw=\"1\"></i>Sau khi sửa nhãn Nmap</span>\n        <span><i class=\"au-sw line\" data-sw=\"crit\"></i>Mục tiêu</span>\n      </div>\n      <div class=\"au-chart\" id=\"chart-combos\" data-draw=\"combos\" data-source=\"combos\"></div>\n    </div>\n  </section>\n\n  <section class=\"au-sec\" id=\"dinh-nghia-cum\">\n    <h2>Đổi cách gom cụm cũng không đạt mục tiêu</h2>\n    <p>Khoảng giữa tổ hợp ít cụm nhất và nhiều cụm nhất, theo event_label gốc.</p>\n    <div class=\"au-card\">\n      <div class=\"au-chart\" id=\"chart-defs\" data-draw=\"defs\" data-source=\"defs\"></div>\n    </div>\n  </section>\n\n  <details id=\"dinh-nghia\">\n    <summary>Định nghĩa và cách tính</summary>\n    <dl>\n      <dt>Phạm vi sản phẩm</dt>\n      <dd>Chỉ các alert trong <code>&lt;kịch bản&gt;_wazuh.json</code>, gồm Wazuh và Suricata do Wazuh thu. Không có AMiner. Bỏ <code>/var/log/suricata/fast.log</code> (bản sao 1:1 của eve.json) và <code>/var/log/mail.info</code> (bản sao của mail.log).</dd>\n      <dt>Alert tấn công</dt>\n      <dd>event_label khác \"-\". Nhãn này do analyze.py của AIT gán, bằng cách so dòng log với file nhãn của AIT-LDSv2.</dd>\n      <dt>Cụm</dt>\n      <dd>Gom gần đúng theo (rule.id, host, IP nguồn). Mở cụm mới khi hai alert liền nhau cách quá 30 phút. Cụm tấn công là cụm có ít nhất một alert tấn công. Cụm thật sẽ do bước pre-triage của sản phẩm tạo ra.</dd>\n      <dt>Sửa nhãn Nmap</dt>\n      <dd>Coi là tấn công các alert có \"nmap\" trong log hoặc chữ ký Suricata \"ET SCAN Possible Nmap\". Đây là sửa tối thiểu, chưa thay cho kiểm tra tay.</dd>\n      <dt>Đối chiếu CATS</dt>\n      <dd>Bỏ các rule Wazuh nhóm IDS (bản fast.log) thì russellmitchell còn đúng 23.116 alert Wazuh, trùng số trong paper CATS.</dd>\n    </dl>\n  </details>\n</div>\n\n<script>\n  window.AU = (() => {\n    const loc = d3.formatLocale({ decimal: ',', thousands: '.', grouping: [3], currency: ['', ''] });\n    const int = loc.format(',d');\n    const dec1 = loc.format(',.1f');\n    const dec2 = loc.format(',.2f');\n    const n = (v) => (v === '' || v == null ? NaN : +v);\n    const TARGET = 100;\n    const state = { typeaScenario: 'russellmitchell' };\n\n    // Trả về data của các nguồn, hoặc null và vẽ trạng thái chờ/lỗi.\n    function ready(el, ids, text) {\n      for (const id of ids) {\n        const r = dash.data(id);\n        if (r.status !== 'ok') {\n          el.replaceChildren();\n          if (r.status === 'loading') { el.classList.add('dash-skeleton'); if (text) el.textContent = '—'; }\n          else {\n            el.classList.remove('dash-skeleton');\n            if (!text && (r.status === 'error' || r.status === 'missing')) {\n              const p = document.createElement('p'); p.className = 'au-fail'; p.textContent = 'Không tải được dữ liệu'; el.appendChild(p);\n            } else el.textContent = '—';\n          }\n          return null;\n        }\n      }\n      el.classList.remove('dash-skeleton');\n      return ids.map((id) => dash.data(id).data);\n    }\n\n    function tip(el) {\n      const t = document.createElement('div');\n      t.className = 'au-tip'; t.hidden = true; el.appendChild(t);\n      return {\n        show(lines, x, y) {\n          t.replaceChildren(...lines.map((l, i) => { const d = document.createElement('div'); d.textContent = l; if (i === 0) d.className = 'au-tip-h'; return d; }));\n          t.hidden = false;\n          const w = el.clientWidth, tw = t.offsetWidth, th = t.offsetHeight;\n          t.style.left = Math.max(0, Math.min(w - tw, x + 12)) + 'px';\n          t.style.top = (y - th - 10 < 0 ? y + 14 : y - th - 10) + 'px';\n        },\n        hide() { t.hidden = true; },\n      };\n    }\n\n    function textWidth(svg, strings) {\n      const g = svg.append('g').attr('class', 'au-axis');\n      let w = 0;\n      for (const s of strings) { const t = g.append('text').text(s); w = Math.max(w, t.node().getComputedTextLength()); }\n      g.remove();\n      return w;\n    }\n\n    function svgIn(el, h, label) {\n      el.replaceChildren();\n      const w = Math.max(280, el.clientWidth);\n      const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${w} ${h}`)\n        .attr('role', 'img').attr('aria-label', label);\n      return { svg, w };\n    }\n\n    const swatch = (k) => k === 'muted' ? 'var(--cds-chart-muted)' : k === 'warn' ? 'var(--color-warn)' : k === 'crit' ? 'var(--cds-chart-status-critical)' : dash.colors[+k];\n\n    return { loc, int, dec1, dec2, n, TARGET, state, ready, tip, textWidth, svgIn, swatch };\n  })();\n\n  document.querySelectorAll('[data-sw]').forEach((s) => { s.style.background = AU.swatch(s.dataset.sw); });\n\n  dash.calc('totals', {\n    inputs: ['stats'],\n    title: 'Tổng 8 kịch bản',\n    description: 'Cộng các cột của bảng theo kịch bản; tỉ lệ alert bị loại = 1 − alert phạm vi SP / alert cả 3 IDS.',\n    fn: (stats) => {\n      const sum = (k) => stats.reduce((a, r) => a + Number(r[k]), 0);\n      return [{\n        attack_clusters: sum('attack_clusters'),\n        attack_clusters_nmap_fixed: sum('attack_clusters_nmap_fixed'),\n        nmap_unlabeled: sum('nmap_unlabeled'),\n        removed_pct: Math.round(1000 * (1 - sum('alerts_product') / sum('alerts_all_ids'))) / 10,\n      }];\n    },\n  });\n\n  dash.calc('combo_summary', {\n    inputs: ['combos'],\n    title: 'Tóm tắt tổ hợp 3 kịch bản',\n    description: 'Cụm tấn công lớn nhất và nhỏ nhất trên các tổ hợp 3 kịch bản, và số tổ hợp đạt mục tiêu 100 cụm.',\n    fn: (combos) => {\n      const fixed = combos.map((r) => Number(r.attack_clusters_nmap_fixed));\n      const raw = combos.map((r) => Number(r.attack_clusters));\n      return [{\n        max_fixed: Math.max(...fixed),\n        max_raw: Math.max(...raw),\n        min_raw: Math.min(...raw),\n        combos: combos.length,\n        reaching_target: fixed.filter((v) => v >= 100).length,\n      }];\n    },\n  });\n</script>\n\n<script>\n  const textDraw = (name, src, field, fmt) => dash.draw(name, (el) => {\n    const d = AU.ready(el, [src], true); if (!d) return;\n    el.textContent = fmt(d[0][0][field]);\n  });\n  textDraw('kpi-maxfixed', 'combo_summary', 'max_fixed', AU.int);\n  textDraw('kpi-maxfixed2', 'combo_summary', 'max_fixed', AU.int);\n  textDraw('kpi-maxraw', 'combo_summary', 'max_raw', AU.int);\n  textDraw('kpi-ncombos', 'combo_summary', 'combos', AU.int);\n  textDraw('kpi-reach', 'combo_summary', 'reaching_target', AU.int);\n  textDraw('kpi-total', 'totals', 'attack_clusters', AU.int);\n  textDraw('kpi-totalfixed', 'totals', 'attack_clusters_nmap_fixed', AU.int);\n  textDraw('kpi-nmap', 'totals', 'nmap_unlabeled', AU.int);\n  textDraw('kpi-removed', 'totals', 'removed_pct', AU.dec1);\n\n  dash.draw('target', (el) => { el.textContent = AU.int(AU.TARGET); });\n\n  dash.draw('kpi-prec', (el) => {\n    const d = AU.ready(el, ['stats'], true); if (!d) return;\n    const r = d[0].find((x) => x.scenario === 'russellmitchell');\n    el.textContent = r ? AU.dec1(AU.n(r.precision_time_pct)) : '—';\n  });\n\n  dash.draw('verdict', (el) => {\n    const r = dash.data('combo_summary');\n    const ok = r.status === 'ok';\n    const reach = ok && r.data[0].max_fixed >= AU.TARGET;\n    document.querySelectorAll('.au-verdict-below').forEach((s) => { s.hidden = !ok || reach; });\n    document.querySelectorAll('.au-verdict-above').forEach((s) => { s.hidden = !ok || !reach; });\n    const chip = document.getElementById('chip-combo');\n    if (chip) { chip.hidden = !ok; chip.className = 'au-chip ' + (reach ? 'ok' : 'bad'); }\n  });\n</script>\n\n<script>\n  // Bảng theo kịch bản\n  dash.draw('scen-table', (tb) => {\n    const d = AU.ready(tb, ['stats']); if (!d) return;\n    const cols = [['scenario', (v) => v], ['alerts_product', AU.int], ['attack_alerts', AU.int], ['agree_pct', AU.dec2],\n      ['type_a', AU.int], ['type_b', AU.int], ['precision_time_pct', AU.dec1], ['recall_time_pct', AU.dec1]];\n    tb.replaceChildren(...d[0].map((r) => {\n      const tr = document.createElement('tr'); tr.dataset.key = r.scenario;\n      for (const [k, f] of cols) {\n        const td = document.createElement('td'); const v = k === 'scenario' ? r[k] : AU.n(r[k]);\n        td.textContent = f(v);\n        if ((k === 'type_b' && v > 0) || (k === 'agree_pct' && v < 95) || (k === 'recall_time_pct' && v < 95)) td.className = 'flag';\n        tr.appendChild(td);\n      }\n      return tr;\n    }));\n  });\n\n  dash.draw('matrix-table', (tb) => {\n    const d = AU.ready(tb, ['matrix']); if (!d) return;\n    tb.replaceChildren(...d[0].map((r) => {\n      const tr = document.createElement('tr'); tr.dataset.key = r.scope;\n      for (const k of ['scope', 'both_attack', 'type_a', 'type_b', 'both_benign']) {\n        const td = document.createElement('td'); td.textContent = k === 'scope' ? r[k] : AU.int(AU.n(r[k])); tr.appendChild(td);\n      }\n      return tr;\n    }));\n  });\n\n  dash.draw('steps-table', (tb) => {\n    const d = AU.ready(tb, ['stats']); if (!d) return;\n    const steps = ['step_service_scan', 'step_wpscan', 'step_dirb', 'step_webshell_cmd', 'step_crack_passwords',\n      'step_attacker_change_user', 'step_escalated_sudo_command', 'step_dnsteal'];\n    const max = d3.max(d[0], (r) => d3.max(steps, (k) => AU.n(r[k])));\n    tb.replaceChildren(...d[0].map((r) => {\n      const tr = document.createElement('tr'); tr.dataset.key = r.scenario;\n      const th = document.createElement('td'); th.textContent = r.scenario; tr.appendChild(th);\n      for (const k of steps) {\n        const v = AU.n(r[k]); const td = document.createElement('td'); td.textContent = AU.int(v);\n        if (v === 0) td.className = 'zero';\n        else td.style.background = `color-mix(in srgb, ${dash.colors[0]} ${Math.round(8 + 32 * v / max)}%, transparent)`;\n        tr.appendChild(td);\n      }\n      return tr;\n    }));\n  });\n</script>\n\n<script>\n  // Thanh ngang xếp chồng 100%: phạm vi và trùng lặp\n  dash.draw('scope', (el) => {\n    const d = AU.ready(el, ['stats']); if (!d) return;\n    const rows = d[0];\n    const keys = [['alerts_product', 'Giữ lại'], ['removed_fastlog', 'Suricata fast.log'], ['removed_mailinfo', 'mail.info'], ['removed_aminer', 'AMiner']];\n    const bh = 18, gap = 10, top = 4, bottom = 24;\n    const { svg, w } = AU.svgIn(el, top + rows.length * (bh + gap) + bottom, 'Tỉ lệ alert giữ lại và bị loại theo kịch bản');\n    const lw = AU.textWidth(svg, rows.map((r) => r.scenario)) + 10;\n    const x = d3.scaleLinear([0, 1], [lw, w - 8]);\n    svg.append('g').attr('class', 'au-axis').attr('transform', `translate(0,${top + rows.length * (bh + gap)})`)\n      .call(d3.axisBottom(x).ticks(w < 420 ? 4 : 5).tickFormat((v) => AU.int(v * 100) + '%'));\n    const tp = AU.tip(el);\n    rows.forEach((r, i) => {\n      const total = AU.n(r.alerts_all_ids); let acc = 0; const y = top + i * (bh + gap);\n      svg.append('text').attr('class', 'au-lab').attr('x', 0).attr('y', y + bh / 2).attr('dy', '0.35em').text(r.scenario);\n      keys.forEach(([k, label], j) => {\n        const v = AU.n(r[k]); const x0 = x(acc / total), x1 = x((acc + v) / total); acc += v;\n        svg.append('rect').attr('x', x0).attr('y', y).attr('height', bh).attr('width', Math.max(0, x1 - x0 - 2))\n          .style('fill', dash.colors[j])\n          .on('pointermove', (ev) => { const [px, py] = d3.pointer(ev, el); tp.show([`${r.scenario} · ${label}`, `${AU.int(v)} alert (${AU.dec1(100 * v / total)}%)`, `Tổng cả 3 IDS: ${AU.int(total)}`], px, py); })\n          .on('pointerleave', () => tp.hide());\n      });\n    });\n  });\n\n  // Kiểu A theo rule\n  dash.draw('typea-sel', (sel) => {\n    const r = dash.data('typea');\n    const names = r.status === 'ok' ? [...new Set(r.data.map((x) => x.scenario))] : [];\n    sel.replaceChildren(...names.map((s) => new Option(s, s)));\n    sel.value = AU.state.typeaScenario;\n    sel.onchange = () => { AU.state.typeaScenario = sel.value; dash.draw('typea'); };\n  });\n\n  dash.draw('typea', (el) => {\n    const d = AU.ready(el, ['typea']); if (!d) return;\n    const rows = d[0].filter((r) => r.scenario === AU.state.typeaScenario);\n    const rowH = 40, top = 2;\n    const { svg, w } = AU.svgIn(el, top + rows.length * rowH + 4, `Alert kiểu A theo rule, kịch bản ${AU.state.typeaScenario}`);\n    const max = d3.max(rows, (r) => AU.n(r.alerts)) || 1;\n    const vw = AU.textWidth(svg, [AU.int(max)]) + 8;\n    const x = d3.scaleLinear([0, max], [0, w - vw - 4]);\n    const tp = AU.tip(el);\n    rows.forEach((r, i) => {\n      const y = top + i * rowH; const v = AU.n(r.alerts);\n      const missed = r.verdict !== 'Nhiễu nền';\n      svg.append('text').attr('class', 'au-lab').attr('x', 0).attr('y', y + 11).text(r.rule.replace(/^(Wazuh|Suricata): (Alert - )?/, ''));\n      svg.append('rect').attr('x', 0).attr('y', y + 17).attr('height', 14).attr('rx', 3).attr('width', Math.max(2, x(v)))\n        .style('fill', dash.colors[missed ? 1 : 0])\n        .on('pointermove', (ev) => { const [px, py] = d3.pointer(ev, el); tp.show([r.rule, `${AU.int(v)} alert kiểu A`, r.verdict], px, py); })\n        .on('pointerleave', () => tp.hide());\n      svg.append('text').attr('class', 'au-val').attr('x', Math.max(2, x(v)) + 6).attr('y', y + 24).attr('dy', '0.35em').text(AU.int(v));\n    });\n  });\n</script>\n\n<script>\n  // Dòng thời gian .biz\n  dash.draw('biz', (el) => {\n    const d = AU.ready(el, ['biz', 'bizmarks']); if (!d) return;\n    const sc = el.dataset.scenario;\n    const pts = d[0].filter((r) => r.scenario === sc).map((r) => ({ t: new Date(r.hour), v: AU.n(r.alerts) }));\n    const marks = d[1].filter((r) => r.scenario === sc).map((r) => ({ ev: r.event, a: new Date(r.start), b: new Date(r.end) }));\n    const h = 190, m = { t: 8, r: 8, b: 26 };\n    const { svg, w } = AU.svgIn(el, h, `Số alert .biz mỗi giờ, kịch bản ${sc}, kèm mốc xâm nhập và service_stop`);\n    const y = d3.scaleLinear([0, d3.max(pts, (p) => p.v) * 1.1], [h - m.b, m.t]).nice();\n    m.l = AU.textWidth(svg, y.ticks(4).map(AU.int)) + 8;\n    const x = d3.scaleUtc(d3.extent(pts, (p) => p.t), [m.l, w - m.r]);\n    svg.append('g').attr('class', 'au-axis au-gridl').attr('transform', `translate(${m.l},0)`)\n      .call(d3.axisLeft(y).ticks(4).tickSize(-(w - m.l - m.r)).tickFormat(AU.int));\n    svg.append('g').attr('class', 'au-axis').attr('transform', `translate(0,${h - m.b})`)\n      .call(d3.axisBottom(x).ticks(d3.utcDay.every(1)).tickFormat(d3.utcFormat('%d/%m')));\n    const color = { 'Chuỗi xâm nhập': 'var(--cds-chart-muted)', 'Khung dnsteal của time_label': 'var(--color-warn)' };\n    for (const mk of marks) {\n      if (mk.ev === 'service_stop') continue;\n      svg.append('rect').attr('x', x(mk.a)).attr('width', Math.max(3, x(mk.b) - x(mk.a))).attr('y', m.t).attr('height', h - m.b - m.t)\n        .style('fill', color[mk.ev]).style('opacity', 0.45);\n    }\n    const area = d3.area().x((p) => x(p.t)).y0(y(0)).y1((p) => y(p.v)).curve(d3.curveLinear);\n    const line = d3.line().x((p) => x(p.t)).y((p) => y(p.v)).curve(d3.curveLinear);\n    svg.append('path').datum(pts).attr('d', area).style('fill', dash.colors[0]).style('opacity', 0.15);\n    svg.append('path').datum(pts).attr('d', line).style('fill', 'none').style('stroke', dash.colors[0]).style('stroke-width', 2);\n    for (const mk of marks.filter((q) => q.ev === 'service_stop')) {\n      svg.append('line').attr('x1', x(mk.a)).attr('x2', x(mk.a)).attr('y1', m.t).attr('y2', h - m.b)\n        .style('stroke', 'var(--cds-chart-status-critical)').style('stroke-width', 2);\n    }\n    const tp = AU.tip(el);\n    const dot = svg.append('circle').attr('r', 4).style('fill', dash.colors[0]).style('stroke', 'var(--color-panel)').style('stroke-width', 2).attr('visibility', 'hidden');\n    const fmt = d3.utcFormat('%d/%m %H:00 UTC');\n    const bis = d3.bisector((p) => p.t).center;\n    svg.append('rect').attr('x', m.l).attr('y', m.t).attr('width', w - m.l - m.r).attr('height', h - m.b - m.t).style('fill', 'transparent')\n      .on('pointermove', (ev) => {\n        const [px] = d3.pointer(ev); const p = pts[bis(pts, x.invert(px))];\n        dot.attr('cx', x(p.t)).attr('cy', y(p.v)).attr('visibility', 'visible');\n        const inMk = marks.filter((q) => p.t >= d3.utcHour.floor(q.a) && p.t <= q.b).map((q) => q.ev);\n        const [ex, ey] = d3.pointer(ev, el);\n        tp.show([fmt(p.t), `${AU.int(p.v)} alert .biz`, ...inMk], ex, ey);\n      })\n      .on('pointerleave', () => { dot.attr('visibility', 'hidden'); tp.hide(); });\n  });\n\n  // Nmap: có nhãn và bị bỏ sót\n  dash.draw('nmap', (el) => {\n    const d = AU.ready(el, ['stats']); if (!d) return;\n    const rows = d[0];\n    const bh = 18, gap = 10, top = 4, bottom = 24;\n    const { svg, w } = AU.svgIn(el, top + rows.length * (bh + gap) + bottom, 'Số alert Nmap có nhãn và bị gán dấu gạch theo kịch bản');\n    const lw = AU.textWidth(svg, rows.map((r) => r.scenario)) + 10;\n    const max = d3.max(rows, (r) => AU.n(r.nmap_labeled) + AU.n(r.nmap_unlabeled));\n    const vw = AU.textWidth(svg, [AU.int(max)]) + 8;\n    const x = d3.scaleLinear([0, max], [lw, w - vw]).nice();\n    svg.append('g').attr('class', 'au-axis au-gridl').attr('transform', `translate(0,${top + rows.length * (bh + gap)})`)\n      .call(d3.axisBottom(x).ticks(5).tickSize(-(rows.length * (bh + gap))).tickFormat(AU.int));\n    const tp = AU.tip(el);\n    rows.forEach((r, i) => {\n      const y = top + i * (bh + gap); const a = AU.n(r.nmap_labeled), b = AU.n(r.nmap_unlabeled);\n      svg.append('text').attr('class', 'au-lab').attr('x', 0).attr('y', y + bh / 2).attr('dy', '0.35em').text(r.scenario);\n      [[a, 0, 'có nhãn tấn công', x(0)], [b, 1, 'bị gán \"-\"', x(a)]].forEach(([v, j, lab, x0]) => {\n        if (!v) return;\n        svg.append('rect').attr('x', x0).attr('y', y).attr('height', bh).attr('width', Math.max(1, x(v) - x(0) - 2)).style('fill', dash.colors[j])\n          .on('pointermove', (ev) => { const [px, py] = d3.pointer(ev, el); tp.show([r.scenario, `${AU.int(v)} alert Nmap ${lab}`], px, py); })\n          .on('pointerleave', () => tp.hide());\n      });\n      svg.append('text').attr('class', 'au-val').attr('x', x(a + b) + 6).attr('y', y + bh / 2).attr('dy', '0.35em')\n        .text(a + b ? `${AU.int(b)} bỏ sót` : 'không có');\n    });\n  });\n</script>\n\n<script>\n  // Cụm tấn công: trước và sau khi sửa nhãn Nmap\n  dash.draw('clusters', (el) => {\n    const d = AU.ready(el, ['stats']); if (!d) return;\n    const rows = d[0];\n    const rh = 26, top = 6, bottom = 24;\n    const { svg, w } = AU.svgIn(el, top + rows.length * rh + bottom, 'Số cụm tấn công mỗi kịch bản trước và sau khi sửa nhãn Nmap');\n    const lw = AU.textWidth(svg, rows.map((r) => r.scenario)) + 10;\n    const max = d3.max(rows, (r) => AU.n(r.attack_clusters_nmap_fixed));\n    const x = d3.scaleLinear([0, max], [lw, w - 40]).nice();\n    svg.append('g').attr('class', 'au-axis au-gridl').attr('transform', `translate(0,${top + rows.length * rh})`)\n      .call(d3.axisBottom(x).ticks(5).tickSize(-(rows.length * rh)).tickFormat(AU.int));\n    const tp = AU.tip(el);\n    rows.forEach((r, i) => {\n      const y = top + i * rh + rh / 2; const a = AU.n(r.attack_clusters), b = AU.n(r.attack_clusters_nmap_fixed);\n      svg.append('text').attr('class', 'au-lab').attr('x', 0).attr('y', y).attr('dy', '0.35em').text(r.scenario);\n      svg.append('line').attr('x1', x(a)).attr('x2', x(b)).attr('y1', y).attr('y2', y).style('stroke', 'var(--cds-chart-muted)').style('stroke-width', 2);\n      const g = svg.append('g')\n        .on('pointermove', (ev) => { const [px, py] = d3.pointer(ev, el); tp.show([r.scenario, `Theo event_label gốc: ${AU.int(a)} cụm`, `Sau khi sửa nhãn Nmap: ${AU.int(b)} cụm`], px, py); })\n        .on('pointerleave', () => tp.hide());\n      g.append('rect').attr('x', lw).attr('y', y - rh / 2).attr('width', w - lw).attr('height', rh).style('fill', 'transparent');\n      [[a, 0], [b, 1]].forEach(([v, j]) => g.append('circle').attr('cx', x(v)).attr('cy', y).attr('r', 5)\n        .style('fill', dash.colors[j]).style('stroke', 'var(--color-panel)').style('stroke-width', 2));\n      svg.append('text').attr('class', 'au-val').attr('x', x(Math.max(a, b)) + 10).attr('y', y).attr('dy', '0.35em').text(AU.int(b));\n    });\n  });\n\n  // Các tổ hợp 3 kịch bản: chấm xếp chồng theo giá trị\n  dash.draw('combos', (el) => {\n    const d = AU.ready(el, ['combos']); if (!d) return;\n    const rows = d[0];\n    const series = [['attack_clusters', 'Theo event_label gốc', 0], ['attack_clusters_nmap_fixed', 'Sau khi sửa nhãn Nmap', 1]];\n    const r = 4, step = 9;\n    const stacks = series.map(([k]) => d3.rollup(rows, (v) => v.length, (q) => AU.n(q[k])));\n    const bandH = series.map((_, i) => (d3.max([...stacks[i].values()]) || 1) * step + 18);\n    const top = 18, bottom = 24, h = top + d3.sum(bandH) + bottom;\n    const { svg, w } = AU.svgIn(el, h, 'Tổng số cụm tấn công của từng tổ hợp 3 kịch bản so với mục tiêu');\n    const lo = Math.min(40, d3.min(rows, (q) => AU.n(q.attack_clusters)));\n    const x = d3.scaleLinear([lo, Math.max(AU.TARGET, d3.max(rows, (q) => AU.n(q.attack_clusters_nmap_fixed))) + 5], [8, w - 8]);\n    svg.append('g').attr('class', 'au-axis').attr('transform', `translate(0,${h - bottom})`).call(d3.axisBottom(x).ticks(6).tickFormat(AU.int));\n    svg.append('line').attr('x1', x(AU.TARGET)).attr('x2', x(AU.TARGET)).attr('y1', top - 4).attr('y2', h - bottom)\n      .style('stroke', 'var(--cds-chart-status-critical)').style('stroke-width', 2).style('stroke-dasharray', '4 3');\n    svg.append('text').attr('class', 'au-lab').attr('x', x(AU.TARGET) - 6).attr('y', top - 8).attr('text-anchor', 'end').text(`Mục tiêu ${AU.int(AU.TARGET)}`);\n    const tp = AU.tip(el);\n    let y0 = top;\n    series.forEach(([k, label, j], i) => {\n      svg.append('text').attr('class', 'au-lab').attr('x', 8).attr('y', y0 + 10).text(label);\n      const base = y0 + bandH[i] - 4; const seen = new Map();\n      [...rows].sort((a, b) => AU.n(a[k]) - AU.n(b[k])).forEach((q) => {\n        const v = AU.n(q[k]); const c = seen.get(v) || 0; seen.set(v, c + 1);\n        svg.append('circle').attr('cx', x(v)).attr('cy', base - r - c * step).attr('r', r).style('fill', dash.colors[j])\n          .on('pointermove', (ev) => { const [px, py] = d3.pointer(ev, el); tp.show([q.combo, `${label}: ${AU.int(v)} cụm`], px, py); })\n          .on('pointerleave', () => tp.hide());\n      });\n      y0 += bandH[i];\n    });\n  });\n\n  // Độ nhạy theo định nghĩa cụm\n  dash.draw('defs', (el) => {\n    const d = AU.ready(el, ['defs']); if (!d) return;\n    const rows = d[0];\n    const rh = 40, top = 18, bottom = 24;\n    const { svg, w } = AU.svgIn(el, top + rows.length * rh + bottom, 'Khoảng số cụm tấn công của tổ hợp 3 kịch bản theo từng cách gom cụm');\n    const x = d3.scaleLinear([0, AU.TARGET + 5], [8, w - 30]);\n    svg.append('g').attr('class', 'au-axis au-gridl').attr('transform', `translate(0,${top + rows.length * rh})`)\n      .call(d3.axisBottom(x).ticks(5).tickSize(-(rows.length * rh)).tickFormat(AU.int));\n    svg.append('line').attr('x1', x(AU.TARGET)).attr('x2', x(AU.TARGET)).attr('y1', top - 4).attr('y2', top + rows.length * rh)\n      .style('stroke', 'var(--cds-chart-status-critical)').style('stroke-width', 2).style('stroke-dasharray', '4 3');\n    svg.append('text').attr('class', 'au-lab').attr('x', x(AU.TARGET) - 6).attr('y', top - 8).attr('text-anchor', 'end').text(`Mục tiêu ${AU.int(AU.TARGET)}`);\n    const tp = AU.tip(el);\n    rows.forEach((q, i) => {\n      const y = top + i * rh; const a = AU.n(q.combo_min), b = AU.n(q.combo_max);\n      svg.append('text').attr('class', 'au-lab').attr('x', 8).attr('y', y + 10).text(q.definition);\n      svg.append('rect').attr('x', x(a)).attr('y', y + 17).attr('height', 12).attr('rx', 3).attr('width', Math.max(3, x(b) - x(a)))\n        .style('fill', dash.colors[0])\n        .on('pointermove', (ev) => { const [px, py] = d3.pointer(ev, el); tp.show([q.definition, `Ít nhất ${AU.int(a)}, nhiều nhất ${AU.int(b)} cụm`], px, py); })\n        .on('pointerleave', () => tp.hide());\n      svg.append('text').attr('class', 'au-val').attr('x', x(b) + 6).attr('y', y + 23).attr('dy', '0.35em').text(`${AU.int(a)}–${AU.int(b)}`);\n    });\n  });\n</script>\n", "edit": {"via": "claude", "at": "2026-11-12T13:30:00Z"}}